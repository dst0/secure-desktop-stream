[Unit]
Description=Sunshine for private Secure Desktop Stream (sds-host)
BindsTo=sds-host-display.service
After=sds-host-display.service
PartOf=sds-host-display.service
StartLimitIntervalSec=0

[Service]
Environment=DISPLAY=:97 XAUTHORITY=%t/sds-host-display/Xauthority
Environment=XDG_SESSION_TYPE=x11
Environment=XDG_CONFIG_HOME=%h/.config/sds-host-sunshine/config
Environment=XDG_DATA_HOME=%h/.local/share/sds-host-sunshine
Environment=XDG_CACHE_HOME=%h/.cache/sds-host-sunshine
Environment=XDG_STATE_HOME=%h/.local/state/sds-host-sunshine
Environment=SUNSHINE_ASSETS_DIR=/opt/secure-desktop-stream-sds-host/assets
UnsetEnvironment=WAYLAND_DISPLAY WAYLAND_SOCKET DBUS_SESSION_BUS_ADDRESS SSH_AUTH_SOCK GNOME_KEYRING_CONTROL GPG_AGENT_INFO
UMask=0077
ExecStart=/opt/secure-desktop-stream-sds-host/sunshine %h/.config/sds-host-sunshine/sunshine.conf
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
LockPersonality=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
InaccessiblePaths=-/run/docker.sock

[Install]
WantedBy=sds-host-display.service
