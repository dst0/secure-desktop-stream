# Hardened Secure Desktop Stream Sunshine reference configuration (default: sds-host / vaapi)
# Run `sds-installer gen-config` to render a concrete config for your instance slug and encoder.
origin_web_ui_allowed = pc
lan_encryption_mode = 2
wan_encryption_mode = 2
upnp = disabled
mdns_advertise = disabled
sds_default_permissions =
stream_audio = enabled
audio_sink = sds-host-output
clipboard = enabled
file_transfer = enabled
file_clipboard = enabled
mic_passthrough = enabled
encoder = vaapi
# Optional: adapter_name = /dev/dri/renderD128
